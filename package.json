{
    "name": "ohara",
    "version": "0.1.0",
    "private": true,
    "description": "Ohara is an open-source platform for discovering, organizing, and tracking books, built as part of the Yomikai ecosystem.",
    "author": "AdityaP183",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YomikaiHub/ohara.git"
    },
    "bugs": {
        "url": "https://github.com/YomikaiHub/ohara/issues"
    },
    "homepage": "https://github.com/YomikaiHub/ohara#readme",
    "keywords": [
        "ohara",
        "yomikai",
        "books",
        "library",
        "tracking",
        "golang",
        "nextjs",
        "typescript",
        "postgresql"
    ],
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "dev": "pnpm --dir web dev",
        "build": "pnpm --dir web build",
        "start": "pnpm --dir web start",
        "lint": "pnpm --dir web lint",
        "lint:fix": "pnpm --dir web lint:fix",
        "format": "pnpm --dir web format",
        "typecheck": "pnpm --dir web typecheck",
        "check": "pnpm --dir web check",
        "db:generate": "pnpm --dir web db:generate",
        "db:migrate": "pnpm --dir web db:migrate",
        "db:push": "pnpm --dir web db:push",
        "db:pull": "pnpm --dir web db:pull",
        "db:studio": "pnpm --dir web db:studio"
    }
}

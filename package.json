{
    "name": "ohara",
    "version": "0.1.0",
    "private": true,
    "description": "Ohara is an open-source platform for discovering, organizing, and tracking books, built as part of the Yomikai ecosystem.",
    "author": "AdityaP183",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YomikaiHub/ohara.git"
    },
    "bugs": {
        "url": "https://github.com/YomikaiHub/ohara/issues"
    },
    "homepage": "https://github.com/YomikaiHub/ohara#readme",
    "keywords": [
        "ohara",
        "yomikai",
        "books",
        "library",
        "tracking",
        "golang",
        "nextjs",
        "typescript",
        "postgresql"
    ],
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "prepare": "husky",
        "dev": "pnpm --filter @ohara/web dev",
        "dev:web": "pnpm --filter @ohara/web dev",
        "dev:api": "cd api && air",
        "build:web": "pnpm --filter @ohara/web build",
        "build:api": "cd api && go build -o bin/api ./cmd/api",
        "start": "pnpm --filter @ohara/web start",
        "lint": "pnpm --filter @ohara/web lint",
        "lint:fix": "pnpm --filter @ohara/web lint:fix",
        "format": "pnpm --filter @ohara/web format",
        "typecheck": "pnpm --filter @ohara/web typecheck",
        "check": "pnpm --filter @ohara/web check",
        "test:api": "cd api && go test ./...",
        "lint:api": "cd api && go vet ./...",
        "db:generate": "pnpm --filter @ohara/web db:generate",
        "db:migrate": "pnpm --filter @ohara/web db:migrate",
        "db:push": "pnpm --filter @ohara/web db:push",
        "db:pull": "pnpm --filter @ohara/web db:pull",
        "db:studio": "pnpm --filter @ohara/web db:studio"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8"
    },
    "lint-staged": {
        "web/**/*.{js,jsx,ts,tsx,json,css,md}": [
            "pnpm --filter @ohara/web exec biome check --write"
        ]
    }
}

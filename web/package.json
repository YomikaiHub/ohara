{
    "name": "ohara",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "check": "pnpm lint && pnpm typecheck",
        "prepare": "husky",
        "db:generate": "pnpm exec drizzle-kit generate",
        "db:migrate": "pnpm exec drizzle-kit migrate",
        "db:push": "pnpm exec drizzle-kit push",
        "db:pull": "pnpm exec drizzle-kit pull",
        "db:studio": "pnpm exec drizzle-kit studio"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "drizzle-orm": "1.0.0-rc.4",
        "next": "16.2.9",
        "pg": "^8.22.0",
        "radix-ui": "^1.6.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "shadcn": "^4.11.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.0",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/pg": "^8.20.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "babel-plugin-react-compiler": "1.0.0",
        "drizzle-kit": "1.0.0-rc.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "tailwindcss": "^4",
        "tsx": "^4.22.4",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,md}": [
            "biome check --write"
        ]
    }
}
